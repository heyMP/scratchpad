{
  "name": "@heymp/scratchpad",
  "description": "Run TS/JS snippets in a locally",
  "version": "1.0.0-next.25",
  "main": "src/lib/index.js",
  "module": "src/lib/index.js",
  "type": "module",
  "bin": "bin/cli.js",
  "exports": {
    ".": {
      "types": "./src/lib/index.d.ts.js",
      "default": "./src/lib/index.js"
    }
  },
  "files": [
    "bin/cli.js",
    "templates/**",
    "src/**",
    "types.d.ts"
  ],
  "dependencies": {
    "@clack/prompts": "^1.0.0",
    "@commander-js/extra-typings": "^12.1.0",
    "commander": "^12.0.0",
    "esbuild": "^0.25.10",
    "playwright": "^1.44.1"
  },
  "scripts": {
    "setup": "yarn install && yarn allow-scripts",
    "build": "tsc",
    "build:watch": "tsc -w",
    "test": "yarn build && node --test src/*.test.js",
    "release": "yarn changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.2",
    "@lavamoat/allow-scripts": "^5.0.2",
    "@lavamoat/preinstall-always-fail": "^3.0.0",
    "@types/node": "^22.1.0",
    "typescript": "^5.5.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "lavamoat": {
    "allowScripts": {
      "esbuild#0.25.10": true,
      "@lavamoat/preinstall-always-fail#3.0.0": false
    }
  },
  "packageManager": "yarn@4.18.0"
}
